# Copy to .env and adjust. Never commit the .env file.
POSTGRES_USER=votely
POSTGRES_PASSWORD=change-me
POSTGRES_DB=votely
POSTGRES_PORT=5432

# Backend settings (prefixed with VOTELY_)
VOTELY_DATABASE_URL=postgresql+psycopg://votely:change-me@localhost:5432/votely
VOTELY_LOG_LEVEL=INFO
# Generate with: openssl rand -hex 32
VOTELY_JWT_SECRET=change-me
# Plain HTTP in local development only; keep true everywhere else.
VOTELY_COOKIE_SECURE=false
