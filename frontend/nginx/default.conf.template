# Votely frontend: static single-page application + reverse proxy to the API.
# ${VOTELY_API_UPSTREAM} is substituted when the container starts.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Container liveness, independent from the API.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Re-resolve the API host name regularly: a restarted backend may get a new IP address.
    # NGINX_LOCAL_RESOLVERS is read from /etc/resolv.conf by the image entrypoint.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # Same origin for the browser: /api is forwarded to the backend.
    location /api/ {
        # A variable forces nginx to resolve the name at request time, not only at startup.
        set $api_upstream ${VOTELY_API_UPSTREAM};
        proxy_pass $api_upstream;
        # The client's Host header is not forwarded: it is attacker-controlled and the API
        # does not need it (nginx sends the upstream host instead).
        # Fail fast (502) when the API is down instead of hanging the browser.
        proxy_connect_timeout 5s;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Fingerprinted build assets (index-<hash>.js) never change: cache them for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Client-side routes (/polls/42, /login...) all serve index.html, never cached,
    # so a new deployment is picked up on the next page load.
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
